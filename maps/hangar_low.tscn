[sub_resource type="GDScript" id="GDScript_dnekv"]
resource_name = "hangar_camera"
script/source = "extends Node3D

@onready var cam : Camera3D = %camera
@onready var spring_arm : SpringArm3D = %camera_springarm

@export var cam_angle_max : float = 65
@export var cam_angle_min : float = -65

@export var cam_fov_max : float = 75
@export var cam_fov_min : float = 15

var vel_fov := 0.0

var vel_x := 0.0
var vel_y := 0.0

var enaled := true

func enable(on:bool=true):
	enaled = on

func _unhandled_input(event: InputEvent) -> void:
	if !enaled: return
	
	vel_fov = clampf(vel_fov + 2 * Input.get_axis(\"zoom_in\", \"zoom_out\"), -2, 2)

	if not Util.a_pressed(\"attack1\"):
		return
	if event is InputEventMouseMotion:
		var sens_global := Global.save_settings.mouse_sens
		var mouse_sens := .3
		
		vel_y += -event.relative.x * mouse_sens * .15 * sens_global
		vel_x += -event.relative.y * mouse_sens * .15 * sens_global

func _physics_process(delta: float) -> void:
	self.rotate_y(vel_y * delta)
	spring_arm.rotate_x(vel_x * delta)
	spring_arm.rotation.x = clampf(spring_arm.rotation.x, deg_to_rad(cam_angle_min), deg_to_rad(cam_angle_max))
	
	cam.fov = clampf(cam.fov + vel_fov, cam_fov_min, cam_fov_max)
	
	var coeff : float = minf(delta*80, .9)
	
	vel_fov *= coeff
	
	vel_x *= coeff
	vel_y *= coeff
"

[sub_resource type="GDScript" id="GDScript_s2tt0"]
resource_name = "hangar_chest"
script/source = "extends Node3D

@export var camera_3d: Camera3D
@export var base: RigidBody3D
@export var lid: RigidBody3D
@export var hangar_ui: Control
@export var chest_ui: Control

@export var acc_gold: Label

@export var btn_menu: ButtonCustom
@export var icon_template: TextureRect
@export var rewards_box: HBoxContainer
@export var open_more_cost: Label
@export var open_more: ButtonCustom
@export var animation_player: AnimationPlayer
@export var progress_bar: ProgressBar

var last_entry : Shop.Entry

var orig_pos_base : Vector3
var orig_pos_lid : Vector3

var final_pos_base : Vector3 = Vector3(0.04173, -1.025908, -0.057842)
var final_pos_lid : Vector3 = Vector3(0.044366, -0.849136, -0.05567)




\"TANK, GOLD, CREDITS, FREEXP\"

static var rew_scale : Array[float] = [
	.4, 1, 1, 1
]
static var rew_names : Array[String] = [
	\"Tank\",
	\"Gold\",
	\"Credits\",
	\"Free XP\",
]
static var rew_icons : Array[Texture2D] = [
	load(\"res://assets/gfx/ui/lobby_common/CurrencyIconsHuge05.tres\"),
	load(\"res://assets/gfx/ui/lobby_common/CurrencyIconsBig.tres\"),
	load(\"res://assets/gfx/ui/lobby_common/CurrencyIconsBig02.tres\"),
	load(\"res://assets/gfx/ui/lobby_common/CurrencyIconsBig03.tres\"),
]

func _ready() -> void:
	orig_pos_base = base.position
	orig_pos_lid = lid.position
	
	close()
	
	icon_template.hide()
	btn_menu.pressed.connect(close)
	
	open_more.pressed.connect(func():
		if !last_entry: return
		
		if Global.get_current_player().gold < last_entry.cost_gold:
			close()
			return
		
		animation_player.play(\"woosh\")
		last_entry.on_buy(Global.get_current_player())
	)

func open(rewards:Array[Dictionary], shop_entry:Shop.Entry, guaranteed_reward_id:String, guaranteed_reward_max:int):
	var acc : Account = Global.get_current_player()
	
	last_entry = shop_entry
	
	progress_bar.value = acc.get_guaranteed_reward_points(guaranteed_reward_id)
	progress_bar.max_value = guaranteed_reward_max
	
	animation_player.play(\"woosh\")
	
	open_more_cost.text = Util.format_number(shop_entry.cost_gold)
	open_more_cost.modulate = Color.RED if acc.gold < shop_entry.cost_gold else Color.WHITE
	
	acc_gold.text = Util.format_number(acc.gold)
	Util.timer(.1, func():
		acc_gold.text = Util.format_number(acc.gold)
	)
	
	camera_3d.current = true
	base.position = orig_pos_base
	lid.position = orig_pos_lid
	chest_ui.show()
	hangar_ui.hide()
	
	for c in rewards_box.get_children():
		if c != icon_template: c.queue_free()
		
	for r in rewards:
		var icon : Control = icon_template.duplicate()
		
		icon.get_node(\"reward_type\").text = tr(rew_names[r.type])
		
		if r.type == Shop.ContainerLoot.LootType.TANK:
			print(\"recceived tank: \", r.value)
			
			var info : TankInfoMain = TanksDataBase.get_tank_by_name(r.value)
			if info.name == Global.BASE_TANK: continue
			
			icon.get_node(\"reward_icon\").texture = load(info.icon)
			icon.get_node(\"value\").text = info.display_name_short
			(icon.get_node(\"value\") as Label).add_theme_font_size_override(\"font_size\", 20)
			#(icon.get_node(\"value\") as Label).self_modulate = Color.ORANGE
			
			print(\"recceived tank: \", r.value)
		else:
			icon.get_node(\"reward_icon\").texture = rew_icons[r.type]
			icon.get_node(\"value\").text = Util.format_number(r.value)
		
		icon.get_node(\"reward_icon\").scale.x = rew_scale[r.type]
		icon.get_node(\"reward_icon\").scale.y = rew_scale[r.type]
		
		icon.show()
		
		rewards_box.add_child(icon)

func skip_open():
	base.position = final_pos_base
	lid.position = final_pos_lid

func close():
	camera_3d.current = false
	chest_ui.hide()
	hangar_ui.show()
"

