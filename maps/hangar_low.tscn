[sub_resource type="Shader" id="Shader_qcnmj"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.5.1.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;
stencil_mode write, write_depth_fail, compare_greater_or_equal, 1;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_crashed : source_color, filter_linear_mipmap, repeat_enable;

uniform bool crashed = false;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}

uniform bool use_alpha = false;
uniform float metallic = .25;

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;
	
	METALLIC = max(.7 - albedo_tex.a, 0);
	SPECULAR = 1.;

	ROUGHNESS = albedo_tex.a;
}
"

