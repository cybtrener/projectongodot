[sub_resource type="GDScript" id="GDScript_7wyav"]
resource_name = "login_screen"
script/source = "extends CanvasLayer



func _ready() -> void:
	%tabs.current_tab = 0
	
	$t_version.text = Global.VERSION
	update()
	%l_login.focus_entered.connect(
	func():
		pass
	)
	%l_login.focus_exited.connect(
	func():
		pass
	)
	
	%l_password.focus_entered.connect(
	func():
		pass
	)
	%l_password.focus_exited.connect(
	func():
		pass
	)

func update():
	var save := Global.save_main
	if save.accounts.has(save.current_acc):
		%current_akk.text = tr(\"LOGIN_CURRENT_AKK\") + \"'\"+save.accounts[save.current_acc].name + \"'\"
	else:
		%current_akk.text = tr(\"LOGIN_CURRENT_AKK\") + \"None\"
	%accounts_manager.update()

func try_login() -> void:
	var login : String = %l_login.text
	var password : String = %l_password.text
	
	if login.is_empty() or password.is_empty():
		pass
	
	var key := login+\":\"+password
	var save := Global.save_main
	
	if save.accounts.has(key):
		save.switch_account(key)
		
		_on_play()
	else:
		%error_text.visible = true
		await Util.delay(5)
		%error_text.visible = false
	update()

func back_to_play_button():
	%tabs.current_tab = 0
func _on_play() -> void:
	var save := Global.save_main
	if save.accounts.has(save.current_acc):
		save.login_into_current_account()
		
		Global.to_hangar()
	else:
		%tabs.current_tab = 2
func to_manage_accounts() -> void:
	update()
	%tabs.current_tab = 2
func to_account_creator() -> void:
	%tabs.current_tab = 3
"

[sub_resource type="AtlasTexture" id="AtlasTexture_td5sv"]
