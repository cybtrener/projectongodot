[sub_resource type="GDScript" id="GDScript_1v26g"]
resource_name = "accounts_manager"
script/source = "extends Control

@onready var list := %accounts
@export var login_screen : Node

var template := load(\"res://assets/gfx/ui/login/account.tscn\")

func _ready() -> void:
	update()
	
func update():
	for c in list.get_children(): c.queue_free()
	var save := Global.save_main
	for key in save.accounts.keys():
		var temp = template.instantiate()
		
		temp.login_screen = self.login_screen
		temp.acc_key = key
		
		list.add_child(temp)
		temp.setup(save.accounts[key], save.current_acc == key)
"

[sub_resource type="AtlasTexture" id="AtlasTexture_dpu28"]
atlas = ExtResource("10_faf10")
region = Rect2(519, 1, 100, 146)

[sub_resource type="GDScript" id="GDScript_svil3"]
resource_name = "account_creator"
script/source = "extends Control

@onready var field_name = $VBoxContainer/MarginContainer3/l_nickname
@onready var field_login = $VBoxContainer/MarginContainer/l_login
@onready var field_password = $VBoxContainer/MarginContainer2/l_password

@export var login_screen : Node

func try_account_create():
	if field_name.text.is_empty() or field_login.text.is_empty() or field_password.text.is_empty():
		err(\"LOGIN_CREATE/empty_fields\")
		return
	if Global.save_main.login_used(field_login.text):
		err(\"LOGIN_CREATE/login_used\")
		return
	if Global.save_main.login_used(field_login.text):
		err(\"LOGIN_CREATE/login_used\")
		return
		
	Global.save_main.create_account(field_name.text, field_login.text, field_password.text)
	field_name.text = \"\"
	field_login.text = \"\"
	field_password.text = \"\"
	%tabs.current_tab = 1

func err(err:String):
	$error_text.text = tr(err)
	$error_text.visible = true
	await Util.delay(5)
	$error_text.visible = false
"

