[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://lang.en.translation", "res://lang.ru.translation")

[layer_names]

3d_physics/layer_1="static"
3d_physics/layer_2="physics"
3d_physics/layer_3="wheel"
3d_physics/layer_4="armor"
3d_physics/layer_5="screen"
3d_physics/layer_6="foliage"
3d_physics/layer_7="visibility"
3d_physics/layer_8="modules"
3d_physics/layer_9="destructibles"

[navigation]

pathfinding/max_threads=2
3d/merge_rasterizer_cell_scale=0.35

[physics]

common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=2
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=false
jolt_physics_3d/simulation/baumgarte_stabilization_factor=0.0
jolt_physics_3d/simulation/bounce_velocity_threshold=10.0
jolt_physics_3d/simulation/sleep_velocity_threshold=0.1
jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=false
jolt_physics_3d/motion_queries/recovery_iterations=2
3d/default_gravity=10.0
3d/sleep_threshold_linear=0.02
3d/solver/solver_iterations=4
common/enable_object_picking=false

[rendering]

rendering_device/vsync/swapchain_image_count=2
gl_compatibility/driver="d3d11"
renderer/rendering_method="mobile"
driver/threads/thread_model=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/directional_shadow/size.mobile=256
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
gl_compatibility/item_buffer_size=8192
shading/overrides/force_vertex_shading=true
shading/overrides/force_lambert_over_burley=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=1
environment/ssao/quality=0
environment/ssil/quality=0
occlusion_culling/occlusion_rays_per_thread=256
environment/glow/upscale_mode=0
limits/spatial_indexer/update_iterations_per_frame=4
